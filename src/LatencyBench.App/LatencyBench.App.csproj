<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LatencyBench.Core\LatencyBench.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- ApplicationIcon alone only covers the Win32 resource. WPF's Window.Icon is a separate
         lookup, so the same file is also embedded as a resource for the title bar and Alt+Tab. -->
    <Resource Include="Assets\LatencyBench.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Self-contained publish: bundles the .NET runtime, so the target machine needs nothing
         preinstalled. Applies only to `dotnet publish` (a plain `dotnet build` ignores
         RuntimeIdentifier), so day-to-day building and debugging is unaffected. RuntimeIdentifier is
         required by SelfContained and matches PlatformTarget above and LatencyBench.iss's PublishDir.

         PublishSingleFile is deliberately OFF, and must stay off. It was enabled here for packaging
         tidiness and it silently broke DPC/ISR tracing outright — the single most important feature
         in the app. TraceEvent loads KernelTraceControl.dll by building a path from its own
         assembly's location, and under single-file publishing Assembly.Location is an empty string
         by design, so the lookup resolves to a nonexistent root path. The failure is not a missing
         file — with IncludeNativeLibrariesForSelfExtract the DLL is extracted to the temp cache
         perfectly well — it is that TraceEvent cannot be told where the extracted copy went. It
         surfaces as Win32Exception 126 ("The specified module could not be found") from
         ETWKernelControl.LoadKernelTraceControl(), and nothing about it is visible at build time:
         it compiles cleanly, the app starts, every other tab works, and only the trace fails.

         Verified by running the real published build both ways: single-file -> error 126 on every
         trace attempt; multi-file -> the ETW kernel session starts and collects samples. The native
         DLLs (amd64/x86/arm64 KernelTraceControl.dll and msdia140.dll) ship as real files next to
         the exe, which is exactly what TraceEvent's loader expects. The installer already packages
         the whole publish folder recursively, so this costs nothing at install time. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Deliberately NOT PublishTrimmed: WPF resolves a great deal through reflection (XAML markup
         compilation, DataTemplate/converter lookup by StaticResource key, MVVM source-generated
         property change handlers), and the trimmer cannot always prove those paths reachable. An
         untested trim pass risks removing something a specific tab needs only at runtime — exactly
         the class of bug that would not show up in a build, only when a user opens that tab. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Compiled into the executable's Win32 resources, which is what Explorer, the taskbar, the
         Start menu, Alt+Tab and any shortcut pointing at the exe all read. -->
    <ApplicationIcon>Assets\LatencyBench.ico</ApplicationIcon>
    <!-- Display metadata only (shown in Explorer's file Properties / taskbar tooltip) — deliberately
         NOT the AssemblyName, project filename, or C# namespace, all of which stay LatencyBench.* so this
         rename touches nothing the source code depends on. -->
    <AssemblyTitle>LatencyBench</AssemblyTitle>
    <Product>LatencyBench by Alisouf</Product>
    <Company>Alisouf</Company>
  </PropertyGroup>

</Project>
