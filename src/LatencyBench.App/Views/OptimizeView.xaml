<UserControl x:Class="LatencyBench.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LatencyBench.App.ViewModels"
             xmlns:controls="clr-namespace:LatencyBench.App.Controls"
             d:DataContext="{d:DesignInstance Type=vm:OptimizeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <DockPanel Margin="24">

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <controls:Icon Kind="Advisor" IconBrush="{StaticResource TextPrimaryBrush}" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="Optimize" Style="{StaticResource HeadingText}"/>
            </StackPanel>
            <Button Content="Re-analyse" Style="{StaticResource AppButton}" DockPanel.Dock="Right" Margin="0,0,8,0"
                    Command="{Binding AnalyzeCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,0,0,12"
                   Text="Analyses this PC, then shows exactly what the chosen profile would change and why. Nothing is written until you click Apply."/>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Style="{StaticResource SecondaryText}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding Status, Converter={StaticResource StringToVisibilityConverter}}"/>

        <!-- No inner ScrollViewer: MainWindow already wraps each tab in one, and nesting a second
             swallows the mouse wheel without scrolling anything. -->
        <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">

            <!-- Profile picker -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Profile" Style="{StaticResource BodyText}" FontWeight="Medium" Margin="0,0,0,10"/>
                    <!-- A ListBox rather than hand-rolled RadioButtons: selection is already two-way
                         bindable, keyboard navigation comes for free, and there is no converter
                         needed to work out which item is the selected one. -->
                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                             Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProfileOptionViewModel}">
                                <StackPanel Margin="2,4,2,6">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Plan summary and controls -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock Text="Plan" Style="{StaticResource BodyText}" FontWeight="Medium"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <Button Content="Apply" Style="{StaticResource AppButton}" DockPanel.Dock="Right"
                                Command="{Binding ApplyCommand}" IsEnabled="{Binding HasPlan}"/>
                    </DockPanel>

                    <!-- The per-profile verdict. This is the line that makes selecting a profile
                         visibly do something on a PC where no profile has anything left to change:
                         without it, an empty plan and a greyed-out Apply button are indistinguishable
                         from a selector that is simply not wired up. Turns green once the selected
                         profile has nothing left to do, so "finished" never reads as "broken". -->
                    <TextBlock Text="{Binding ProfileStatusSummary}"
                               TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="Medium"
                               Visibility="{Binding ProfileStatusSummary, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFullyOptimizedForProfile}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding PlanSummary, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <!-- Why Apply is greyed out. An empty plan is a normal, healthy outcome, but a
                         disabled button with no stated reason is indistinguishable from a broken page. -->
                    <TextBlock Text="{Binding ApplyDisabledReason}" Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding ApplyDisabledReason, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <CheckBox Content="Create a System Restore point first" IsChecked="{Binding CreateRestorePoint}" Margin="0,0,0,6"/>
                    <CheckBox Content="Advanced mode — choose each change individually" IsChecked="{Binding AdvancedMode}" Margin="0,0,0,6"/>
                    <CheckBox IsChecked="{Binding MeasureBeforeAfter}">
                        <CheckBox.Content>
                            <TextBlock Text="Measure before/after (about 16 seconds added to Apply)" TextWrapping="Wrap"/>
                        </CheckBox.Content>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Steps -->
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PlanStepViewModel}">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                    <CheckBox DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Top"
                                              IsChecked="{Binding IsSelected}"
                                              Visibility="{Binding DataContext.AdvancedMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibleConverter}}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="Medium" TextWrapping="Wrap"/>
                                </DockPanel>

                                <TextBlock Text="{Binding SafetyLabel}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ConfidenceLabel}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding PhaseLabel}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Text="Why" Style="{StaticResource SecondaryText}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Reasoning}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Text="Expected benefit" Style="{StaticResource SecondaryText}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding ExpectedBenefit}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <StackPanel Visibility="{Binding HasRisks, Converter={StaticResource BoolToVisibleConverter}}" Margin="0,0,0,8">
                                    <TextBlock Text="Risks" Style="{StaticResource SecondaryText}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Risks}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                               Foreground="{StaticResource WarningBrush}"/>
                                </StackPanel>

                                <TextBlock Text="Evidence from this PC" Style="{StaticResource SecondaryText}" FontWeight="Medium"/>
                                <ItemsControl ItemsSource="{Binding EvidenceLines}" Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibleConverter}}" Margin="0,6,0,0">
                                    <TextBlock Text="Interactions" Style="{StaticResource SecondaryText}" FontWeight="Medium"/>
                                    <ItemsControl ItemsSource="{Binding ConflictLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource WarningBrush}" Margin="0,1,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Before/after measurement -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12"
                    Visibility="{Binding BenchmarkResult, Converter={StaticResource NullToVisibleConverter}}">
                <StackPanel>
                    <TextBlock Text="Before / after" Style="{StaticResource BodyText}" FontWeight="Medium" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding BenchmarkResult.Headline}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8">
                        <Run Text="{Binding BenchmarkResult.BeforeLabel, Mode=OneWay}"/>
                        <Run Text="  ·  "/>
                        <Run Text="{Binding BenchmarkResult.AfterLabel, Mode=OneWay}"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding BenchmarkResult.MetricLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Results -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12"
                    Visibility="{Binding ResultSummary, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Result" Style="{StaticResource BodyText}" FontWeight="Medium" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StepResultViewModel}">
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
                                        <Run Text="{Binding Outcome, Mode=OneWay}" FontWeight="Medium"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding Title, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                               Foreground="{StaticResource WarningBrush}"
                                               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibleConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Declined by this profile -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12"
                    Visibility="{Binding Skipped.Count, Converter={StaticResource ZeroToVisibleConverter}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="Not included by this profile" Style="{StaticResource BodyText}" FontWeight="Medium" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="These were found but deliberately left out. Switch profile, or apply them individually from their own tab."/>
                    <ItemsControl ItemsSource="{Binding Skipped}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SkippedItemViewModel}">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Checks that found nothing -->
            <Border Style="{StaticResource CardBorder}"
                    Visibility="{Binding NonFindings.Count, Converter={StaticResource ZeroToVisibleConverter}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Text="Checks that found nothing to change" Style="{StaticResource BodyText}" FontWeight="Medium" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Every check runs every time. These are listed so you can see what was examined, not just what was found. Anything marked below is waiting on a measurement rather than settled — running the test it names may turn it into a real recommendation."/>
                    <ItemsControl ItemsSource="{Binding NonFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NonFindingViewModel}">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                                    <!-- NeedsMeasurement was computed for every check and then never
                                         rendered anywhere, so "I could not decide until you measure X"
                                         looked identical to "checked it, nothing needed". -->
                                    <TextBlock Text="Undetermined — needs a measurement before this can be judged."
                                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                               Foreground="{StaticResource WarningBrush}"
                                               Visibility="{Binding NeedsMeasurement, Converter={StaticResource BoolToVisibleConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </DockPanel>
</UserControl>
