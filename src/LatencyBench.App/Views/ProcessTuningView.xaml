<UserControl x:Class="LatencyBench.App.Views.ProcessTuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LatencyBench.App.ViewModels"
             xmlns:controls="clr-namespace:LatencyBench.App.Controls"
             d:DataContext="{d:DesignInstance Type=vm:ProcessTuningViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <DockPanel Margin="24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <controls:Icon Kind="Cpu" IconBrush="{StaticResource TextPrimaryBrush}" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="Processes" Style="{StaticResource HeadingText}"/>
            </StackPanel>
            <Button Content="Refresh" Style="{StaticResource AppButton}" DockPanel.Dock="Right" Margin="0,0,8,0"
                    Command="{Binding RefreshCommand}" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"
                   Text="Priority, I/O priority and CPU affinity for a specific running process. None of this survives closing the process — it is not a setting Windows remembers, it dies with the process and has to be reapplied after every relaunch."/>

        <CheckBox DockPanel.Dock="Top" Content="Only show processes with a window" IsChecked="{Binding WindowedOnly}" Margin="0,0,0,10"/>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Style="{StaticResource SecondaryText}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding Status, Converter={StaticResource StringToVisibilityConverter}}"/>

        <ItemsControl ItemsSource="{Binding Processes}" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ProcessRowViewModel}">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MinWidth="260">
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" FontWeight="Medium" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource SecondaryText}">
                                    <Run Text="PID "/><Run Text="{Binding Id, Mode=OneWay}"/>
                                    <Run Text=" · priority "/><Run Text="{Binding PriorityLabel, Mode=OneWay}"/>
                                    <Run Text=" · I/O "/><Run Text="{Binding IoPriorityLabel, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="Not accessible — running at a higher integrity level" Style="{StaticResource SecondaryText}"
                                           Foreground="{StaticResource WarningBrush}"
                                           Visibility="{Binding IsAccessible, Converter={StaticResource InverseBoolToVisibleConverter}}"/>
                                <TextBlock Text="{Binding DisabledReason}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                           Foreground="{StaticResource WarningBrush}"
                                           Visibility="{Binding IsWriteProtected, Converter={StaticResource BoolToVisibleConverter}}"/>
                                <TextBlock Text="{Binding RowError}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                           Foreground="{StaticResource WarningBrush}"
                                           Visibility="{Binding RowError, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        IsEnabled="{Binding CanModify}">
                                <Button Content="Normal" Style="{StaticResource AppButton}" Margin="4,0,0,0" Command="{Binding SetNormalPriorityCommand}"
                                        ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"/>
                                <Button Content="Above normal" Style="{StaticResource AppButton}" Margin="4,0,0,0" Command="{Binding SetAboveNormalCommand}"
                                        ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"/>
                                <Button Content="High" Style="{StaticResource AppButton}" Margin="4,0,0,0" Command="{Binding SetHighCommand}"
                                        ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"/>
                                <Button Content="I/O normal" Style="{StaticResource AppButton}" Margin="12,0,0,0" Command="{Binding SetNormalIoCommand}"
                                        ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"/>
                                <Button Content="I/O high" Style="{StaticResource AppButton}" Margin="4,0,0,0" Command="{Binding SetHighIoCommand}"
                                        ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"/>
                                <Button Content="Clear affinity" Style="{StaticResource AppButton}" Margin="12,0,0,0"
                                        Command="{Binding ClearAffinityCommand}"
                                        Visibility="{Binding HasCustomAffinity, Converter={StaticResource BoolToVisibleConverter}}"
                                        ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
