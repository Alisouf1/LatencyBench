<UserControl x:Class="LatencyBench.App.Views.DpcIsrView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LatencyBench.App.ViewModels"
             xmlns:controls="clr-namespace:LatencyBench.App.Controls"
             xmlns:dpc="clr-namespace:LatencyBench.Core.DpcIsr;assembly=LatencyBench.Core"
             d:DataContext="{d:DesignInstance Type=vm:DpcIsrViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <!-- LastChildFill="False": every card is docked Top and sized to its own content. Left at the
         default (true), the last card stretches to absorb all leftover height, which leaves a large
         empty area under short content (e.g. the Analysis card when there are no suggested fixes). -->
    <DockPanel Margin="24" LastChildFill="False">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <controls:Icon Kind="DpcIsr" IconBrush="{StaticResource TextPrimaryBrush}" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="DPC / ISR latency" Style="{StaticResource HeadingText}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Trace for" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="72" VerticalAlignment="Center" Margin="0,0,8,0"
                          ItemsSource="{x:Static vm:DpcIsrViewModel.AvailableDurations}"
                          SelectedItem="{Binding SelectedDuration}"
                          IsEnabled="{Binding IsTracing, Converter={StaticResource InverseBoolConverter}}"
                          ToolTip="A fixed length is what makes two traces comparable — an open-ended trace just accumulates a bigger peak the longer it runs."/>
                <Button Content="{Binding IsTracing, Converter={StaticResource TracingLabelConverter}}" Style="{StaticResource AccentButton}"
                        Command="{Binding ToggleCommand}"/>
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Live kernel trace of interrupt (ISR) and deferred procedure call (DPC) execution time — the same mechanism LatencyMon uses. Only one tool can trace this system-wide at a time."
                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <TextBlock DockPanel.Dock="Top" Text="{Binding SecondsRemaining, StringFormat='{}Tracing — {0}s remaining. Go and reproduce the stutter; it stops on its own.'}"
                   Style="{StaticResource BodyText}" FontWeight="Medium" Margin="0,0,0,8"
                   Visibility="{Binding IsTracing, Converter={StaticResource BoolToVisibleConverter}}"/>

        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,16"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <Border Style="{StaticResource CardBorder}" DockPanel.Dock="Top" Margin="0,0,0,16" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
            <StackPanel>
                <TextBlock Text="Spike rate — compare this between settings" Style="{StaticResource SecondaryText}" FontWeight="Medium"/>
                <TextBlock Text="Independent of how long you trace, unlike the peaks below. This is the number to write down when A/B testing a driver or setting."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{Binding HighSpikesPerSecond, StringFormat='{}{0:0.0}/s'}" FontSize="22" FontWeight="Medium"
                                   Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="spikes over 500 µs" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="{Binding BorderlineSpikesPerSecond, StringFormat='{}{0:0.0}/s'}" FontSize="22" FontWeight="Medium"
                                   Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="spikes over 100 µs" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="{Binding TraceSeconds, StringFormat='{}{0:0}s'}" FontSize="22" FontWeight="Medium" Style="{StaticResource BodyText}"/>
                        <TextBlock Text="trace length" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <UniformGrid Columns="2" DockPanel.Dock="Top" Margin="0,0,0,16">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Highest DPC" Style="{StaticResource SecondaryText}"
                               ToolTip="A running peak — it only ever climbs, so a longer trace always shows a bigger number. Don't compare it between runs of different lengths."/>
                    <TextBlock Text="{Binding HighestDpcMicroseconds, StringFormat='{}{0:0} µs'}" FontSize="22" FontWeight="Medium" Margin="0,4,0,0"
                               Foreground="{Binding HighestDpcMicroseconds, Converter={StaticResource MicrosecondsToSeverityBrushConverter}}"/>
                    <TextBlock Text="peak only — grows with trace length" Style="{StaticResource MutedText}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Highest ISR" Style="{StaticResource SecondaryText}"
                               ToolTip="A running peak — it only ever climbs, so a longer trace always shows a bigger number. Don't compare it between runs of different lengths."/>
                    <TextBlock Text="{Binding HighestIsrMicroseconds, StringFormat='{}{0:0} µs'}" FontSize="22" FontWeight="Medium" Margin="0,4,0,0"
                               Foreground="{Binding HighestIsrMicroseconds, Converter={StaticResource MicrosecondsToSeverityBrushConverter}}"/>
                    <TextBlock Text="peak only — grows with trace length" Style="{StaticResource MutedText}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource CardBorder}" DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="Recent activity" Style="{StaticResource SecondaryText}" DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding SampleCount, StringFormat='{}{0} samples'}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                </DockPanel>
                <TextBlock Text="Rolling ~6 seconds, newest on the right. Each bar is the worst DPC/ISR event in a 150 ms window, on a log scale (10 µs ≈ a third, 100 µs ≈ two thirds) and colored by severity — hover a bar for its driver, kind, duration, and time."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding RecentDurations}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Height="64" VerticalAlignment="Bottom"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="8" Margin="0,0,3,0" VerticalAlignment="Bottom" CornerRadius="1"
                                    Background="{Binding DurationMicroseconds, Converter={StaticResource MicrosecondsToSeverityBrushConverter}}"
                                    Height="{Binding DurationMicroseconds, Converter={StaticResource DurationToBarHeightConverter}}">
                                <Border.ToolTip>
                                    <TextBlock>
                                        <Run Text="{Binding DriverName, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Kind, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding DurationMicroseconds, Mode=OneWay, StringFormat='{}{0:0} µs'}"/>
                                        <LineBreak/>
                                        <Run Text="{Binding Timestamp, Mode=OneWay, StringFormat='{}{0:HH:mm:ss.fff}'}"/>
                                    </TextBlock>
                                </Border.ToolTip>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" DockPanel.Dock="Top" Margin="0,0,0,16"
                Visibility="{Binding CoreLoads.Count, Converter={StaticResource ZeroToVisibleConverter}, ConverterParameter=Invert}">
            <StackPanel>
                <TextBlock Text="Interrupts per CPU core" Style="{StaticResource SecondaryText}" Margin="0,0,0,2"/>
                <TextBlock Text="Which cores are actually servicing interrupts. A single core taking most of the load is what core affinity (Affinity tab) can rebalance."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding CoreLoads}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CoreInterruptLoadViewModel}">
                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Text="{Binding SharePercent, StringFormat='{}{0:0}%'}" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                                <!-- Fixed-height plot area with the bar bottom-aligned, so all bars share
                                     one baseline and the core labels below stay on a single line. -->
                                <Grid Height="56" Margin="0,2,0,0">
                                    <Border Height="{Binding Fraction, Converter={StaticResource FractionToBarHeightConverter}}"
                                            VerticalAlignment="Bottom" CornerRadius="2"
                                            Background="{StaticResource AccentBrush}"
                                            ToolTip="{Binding EventCount, StringFormat='{}{0} interrupt/DPC events'}"/>
                                </Grid>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Top interrupt sources" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding TopDrivers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DriverStatViewModel}">
                            <DockPanel Margin="0,4">
                                <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Background="{Binding MaxDurationMicroseconds, Converter={StaticResource MicrosecondsToSeverityBrushConverter}}"/>
                                <TextBlock Text="{Binding DriverName}" Style="{StaticResource BodyText}" DockPanel.Dock="Left"/>
                                <TextBlock Style="{StaticResource SecondaryText}" HorizontalAlignment="Right">
                                    <Run Text="{Binding MaxDurationMicroseconds, StringFormat='{}{0:0} µs max'}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding SampleCount, StringFormat='{}{0} samples'}"/>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No driver data yet — start tracing and let it run for a few seconds."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Visibility="{Binding TopDrivers.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <controls:Icon Kind="Advisor" IconBrush="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                    <TextBlock Text="Analysis" Style="{StaticResource BodyText}" FontWeight="Medium"/>
                </StackPanel>
                <TextBlock Text="{Binding AnalysisMessage}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>

                <Button Content="{Binding IsSaved, Converter={StaticResource SaveTraceLabelConverter}}"
                        Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                        Command="{Binding SaveTraceCommand}"
                        IsEnabled="{Binding IsSaved, Converter={StaticResource InverseBoolConverter}}"
                        Visibility="{Binding LastResult, Converter={StaticResource NullToVisibleConverter}}"
                        ToolTip="Saves this trace along with the GPU's current MSI/IRQ settings, so it can be compared against other configurations."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" DockPanel.Dock="Top" Margin="0,0,0,16"
                Visibility="{Binding ComparisonMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <controls:Icon Kind="Advisor" IconBrush="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                    <TextBlock Text="Compared to your other settings" Style="{StaticResource BodyText}" FontWeight="Medium"/>
                </StackPanel>
                <TextBlock Text="{Binding ComparisonMessage}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" DockPanel.Dock="Top">
            <StackPanel>
                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock Text="Saved traces" Style="{StaticResource SecondaryText}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Button Content="Clear" Style="{StaticResource AppButton}" DockPanel.Dock="Right" Command="{Binding ClearTracesCommand}"
                            Visibility="{Binding SavedTraces.Count, Converter={StaticResource ZeroToVisibleConverter}, ConverterParameter=Invert}"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding SavedTraces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type dpc:DpcIsrTestResult}">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SavedAt, StringFormat='{}{0:MM/dd HH:mm}'}" Style="{StaticResource MutedText}" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ConfigLabel}" Style="{StaticResource SecondaryText}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding HighSpikesPerSecond, StringFormat='{}{0:0.00} spikes/s'}"
                                           Style="{StaticResource BodyText}" FontWeight="Medium" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding DurationSeconds, StringFormat='{}{0:0}s'}" Style="{StaticResource MutedText}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No saved traces yet. Trace with one setting, save it, change the setting, trace again — the difference gets measured for you."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Visibility="{Binding SavedTraces.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
