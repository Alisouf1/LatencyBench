<UserControl x:Class="LatencyBench.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LatencyBench.App.ViewModels"
             xmlns:models="clr-namespace:LatencyBench.Core.Models;assembly=LatencyBench.Core"
             xmlns:advisor="clr-namespace:LatencyBench.Core.Advisor;assembly=LatencyBench.Core"
             xmlns:perf="clr-namespace:LatencyBench.Core.Perf;assembly=LatencyBench.Core"
             xmlns:controls="clr-namespace:LatencyBench.App.Controls"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <StackPanel Margin="24">

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <controls:Icon Kind="Advisor" IconBrush="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                    <TextBlock Text="Action plan" Style="{StaticResource BodyText}" FontWeight="Medium"/>
                </StackPanel>
                <TextBlock Text="Pulled together from every tab — port test, DPC/ISR, affinity, and MSI mode — ranked by what to do first."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <ItemsControl ItemsSource="{Binding DiagnosisFindings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type advisor:DiagnosisFinding}">
                            <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="Medium"
                                                   TextWrapping="Wrap" Margin="0,0,10,0"/>
                                        <Border Grid.Column="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Top"
                                                Background="{Binding Severity, Converter={StaticResource FindingSeverityToBrushConverter}}">
                                            <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="Medium"
                                                       Foreground="{Binding Severity, Converter={StaticResource FindingSeverityToBrushConverter}, ConverterParameter=Foreground}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                                    <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,8,0,0"
                                                  Visibility="{Binding Evidence.Count, Converter={StaticResource ZeroToVisibleConverter}, ConverterParameter=Invert}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                                        <DockPanel>
                                            <TextBlock Text="Do this: " Style="{StaticResource BodyText}" FontWeight="Medium" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding RecommendedAction}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <DockPanel Margin="0,0,0,10" LastChildFill="False">
            <TextBlock Text="Port ranking" Style="{StaticResource SecondaryText}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <Button Content="Clear results" Style="{StaticResource AppButton}" DockPanel.Dock="Right"
                    Command="{Binding ClearResultsCommand}" Visibility="{Binding Ports.Count, Converter={StaticResource ZeroToVisibleConverter}, ConverterParameter=Invert}"/>
        </DockPanel>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Visibility="{Binding Ports.Count, Converter={StaticResource ZeroToVisibleConverter}}">
            <StackPanel HorizontalAlignment="Center" Margin="0,20">
                <TextBlock Text="No ports tested yet" Style="{StaticResource BodyText}" FontWeight="Medium" HorizontalAlignment="Center"/>
                <TextBlock Text="Run a test from the &quot;Port test&quot; tab above — results are saved automatically and stay here to compare."
                           Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"/>
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Ports}" Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:PortRankResult}">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding PortLabel}" Style="{StaticResource BodyText}" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PortLabel}" Margin="0,0,8,0"/>
                                <Border Grid.Column="1" CornerRadius="6" Padding="8,3"
                                        Background="{Binding Rank, Converter={StaticResource RankToBrushConverter}}">
                                    <TextBlock Text="{Binding Rank, Converter={StaticResource RankLabelConverter}}" FontSize="11" FontWeight="Medium"
                                               Foreground="{Binding Rank, Converter={StaticResource RankToBrushConverter}, ConverterParameter=Foreground}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding AverageJitterMs, StringFormat='{}{0:0.000} ms'}" FontSize="22" FontWeight="Medium" Margin="0,10,0,0"/>
                            <TextBlock Text="avg jitter" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock Text="Latency" Style="{StaticResource SecondaryText}" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding AverageLatencyMs, StringFormat='{}{0:0.0} ms'}" Style="{StaticResource BodyText}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock Text="Polling" Style="{StaticResource SecondaryText}" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding PollingRateHz, StringFormat='{}{0} Hz'}" Style="{StaticResource BodyText}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <UniformGrid Columns="2" Margin="0,0,0,16">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel DataContext="{Binding DpcIsr}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <controls:Icon Kind="DpcIsr" IconBrush="{StaticResource TextPrimaryBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="DPC / ISR latency" Style="{StaticResource BodyText}" FontWeight="Medium"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SampleCount, Converter={StaticResource ZeroToVisibleConverter}}">
                        <TextBlock Text="Not tracing yet — start it from the &quot;DPC/ISR&quot; tab above to see live interrupt latency."
                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SampleCount, Converter={StaticResource ZeroToVisibleConverter}, ConverterParameter=Invert}">
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock Text="Highest DPC" Style="{StaticResource SecondaryText}" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding HighestDpcMicroseconds, StringFormat='{}{0:0} µs'}" Style="{StaticResource BodyText}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock Text="Highest ISR" Style="{StaticResource SecondaryText}" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding HighestIsrMicroseconds, StringFormat='{}{0:0} µs'}" Style="{StaticResource BodyText}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Text="{Binding IsTracing, Converter={StaticResource TracingStatusConverter}}"
                                   Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <controls:Icon Kind="Affinity" IconBrush="{StaticResource TextPrimaryBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="Core affinity" Style="{StaticResource BodyText}" FontWeight="Medium"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Affinity.Controllers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HostControllerViewModel}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding AttachedDevicesSummary}" Style="{StaticResource SecondaryText}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FriendlyName}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PolicySummary}" Style="{StaticResource MutedText}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Manage which cores handle each controller's interrupts from the Affinity tab above."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <controls:Icon Kind="Cpu" IconBrush="{StaticResource TextPrimaryBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="Background load" Style="{StaticResource BodyText}" FontWeight="Medium"/>
                    </StackPanel>
                    <Button Content="Refresh" Style="{StaticResource AppButton}" DockPanel.Dock="Right"
                            Command="{Binding RefreshBackgroundLoadCommand}" IsEnabled="{Binding IsSamplingBackgroundLoad, Converter={StaticResource InverseBoolConverter}}"/>
                </DockPanel>
                <TextBlock Text="Top CPU consumers right now — context for what might be competing with a game, not something to act on blindly."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <TextBlock Text="Sampling…" Style="{StaticResource SecondaryText}"
                           Visibility="{Binding IsSamplingBackgroundLoad, Converter={StaticResource BoolToVisibleConverter}}"/>

                <TextBlock Text="Nothing is using significant CPU right now.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSampledBackgroundLoad}" Value="True"/>
                                        <Condition Binding="{Binding IsSamplingBackgroundLoad}" Value="False"/>
                                        <Condition Binding="{Binding BackgroundProcesses.Count}" Value="0"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding BackgroundProcesses}"
                              Visibility="{Binding IsSamplingBackgroundLoad, Converter={StaticResource InverseBoolConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type perf:FlaggedProcess}">
                            <DockPanel Margin="0,3">
                                <TextBlock Text="{Binding CpuPercent, StringFormat='{}{0:0}%'}" Style="{StaticResource BodyText}" FontWeight="Medium"
                                           DockPanel.Dock="Left" Width="42"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding ProcessName}" Style="{StaticResource SecondaryText}"/>
                                    <TextBlock Text="{Binding KnownReason}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                               Visibility="{Binding KnownReason, Converter={StaticResource NullToVisibleConverter}}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <controls:Icon Kind="Advisor" IconBrush="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                    <TextBlock Text="Advisor" Style="{StaticResource BodyText}" FontWeight="Medium"/>
                </StackPanel>
                <TextBlock Text="{Binding AdvisorMessage}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
