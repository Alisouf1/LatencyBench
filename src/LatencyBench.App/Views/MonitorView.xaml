<UserControl x:Class="LatencyBench.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LatencyBench.App.ViewModels"
             xmlns:controls="clr-namespace:LatencyBench.App.Controls"
             d:DataContext="{d:DesignInstance Type=vm:MonitorViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <DockPanel Margin="24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <controls:Icon Kind="DpcIsr" IconBrush="{StaticResource TextPrimaryBrush}" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="Monitor" Style="{StaticResource HeadingText}"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Margin="0,0,8,0" Command="{Binding ToggleMonitoringCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AppButton}">
                        <Setter Property="Content" Value="Start monitoring"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                <Setter Property="Content" Value="Stop monitoring"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"
                   Text="Samples interrupt time, DPC time and available memory every 2 seconds — cheap enough to leave running for hours. This is not the DPC/ISR tracer: it says something is wrong right now, not which driver caused it. Run a trace from the DPC/ISR tab for that."/>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Style="{StaticResource SecondaryText}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding Status, Converter={StaticResource StringToVisibilityConverter}}"/>

        <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,6,6">
                <StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" FontWeight="Medium">
                        <Run Text="DPC time  "/><Run Text="{Binding CurrentDpcTimePercent, StringFormat={}{0:0.0}%, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    <Polyline Points="{Binding DpcHistory, Converter={StaticResource PercentSeriesToPolylinePointsConverter}}"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Height="48" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="6,0,0,6">
                <StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" FontWeight="Medium">
                        <Run Text="Interrupt time  "/><Run Text="{Binding CurrentInterruptTimePercent, StringFormat={}{0:0.0}%, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    <Polyline Points="{Binding InterruptHistory, Converter={StaticResource PercentSeriesToPolylinePointsConverter}}"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Height="48" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,6,6,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" FontWeight="Medium">
                        <Run Text="Processor time  "/><Run Text="{Binding CurrentProcessorTimePercent, StringFormat={}{0:0.0}%, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="6,6,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" FontWeight="Medium">
                        <Run Text="Available memory  "/><Run Text="{Binding CurrentAvailableMemoryPercent, StringFormat={}{0:0.0}%, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource CardBorder}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock Text="Warnings" Style="{StaticResource BodyText}" FontWeight="Medium" DockPanel.Dock="Left"/>
                    <Button Content="Clear" Style="{StaticResource AppButton}" DockPanel.Dock="Right" Command="{Binding ClearLogCommand}"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Nothing to report." Style="{StaticResource SecondaryText}"
                           Visibility="{Binding WarningLog.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
                <ItemsControl ItemsSource="{Binding WarningLog}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WarningLogEntryViewModel}">
                            <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                <Rectangle DockPanel.Dock="Left" Width="4" Margin="0,2,8,2"
                                           Fill="{Binding Severity, Converter={StaticResource WarningSeverityToBrushConverter}}"/>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
                                    <Run Text="{Binding Timestamp, Mode=OneWay}" FontWeight="Medium"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding Message, Mode=OneWay}"/>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
