<UserControl x:Class="LatencyBench.App.Views.MouseTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LatencyBench.App.ViewModels"
             xmlns:controls="clr-namespace:LatencyBench.App.Controls"
             d:DataContext="{d:DesignInstance Type=vm:MouseTestViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <!-- LastChildFill="False": every card is docked Top and sized to its own content, so the last
         card (saved runs) doesn't stretch to absorb all leftover height. Same layout idiom as PortTestView. -->
    <DockPanel Margin="24" LastChildFill="False">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <controls:Icon Kind="Mouse" IconBrush="{StaticResource TextPrimaryBrush}" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="Mouse test" Style="{StaticResource HeadingText}"/>
            </StackPanel>
            <Button Content="Refresh devices" Style="{StaticResource AppButton}" DockPanel.Dock="Right"
                    Command="{Binding RefreshDevicesCommand}"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="Captures the actual movement your mouse reports — not just when, but how much — and plots it. Start, move the mouse, Stop, then read the trace for dropped/duplicated reports (spikes), angle snapping, and on-device acceleration."
                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Border Style="{StaticResource CardBorder}" DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Mouse" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayLabel" IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Start" Style="{StaticResource AccentButton}"
                            Command="{Binding StartCaptureCommand}" IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Content="Stop" Style="{StaticResource AppButton}" Margin="8,0,0,0"
                            Command="{Binding StopCaptureCommand}" IsEnabled="{Binding IsTesting}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding HasElapsedTime, Converter={StaticResource BoolToVisibleConverter}}">
                    <TextBlock Text="{Binding ElapsedTimeLabel}" Style="{StaticResource BodyText}" FontWeight="Medium" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding LiveSampleCount, StringFormat='{}· {0} samples so far'}" Style="{StaticResource SecondaryText}" Margin="8,0,0,0"
                               Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibleConverter}}"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" DockPanel.Dock="Top" Margin="0,0,0,16"
                Visibility="{Binding HasChartData, Converter={StaticResource BoolToVisibleConverter}}">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left" Text="Trace" Style="{StaticResource BodyText}" FontWeight="Medium" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <RadioButton GroupName="ChartMode" Content="X counts / time" Margin="0,0,12,0" VerticalAlignment="Center"
                                     IsChecked="{Binding SelectedChartMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=XCountsVsTime}"/>
                        <RadioButton GroupName="ChartMode" Content="Y counts / time" Margin="0,0,12,0" VerticalAlignment="Center"
                                     IsChecked="{Binding SelectedChartMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=YCountsVsTime}"/>
                        <RadioButton GroupName="ChartMode" Content="Path (X-Y)" VerticalAlignment="Center"
                                     IsChecked="{Binding SelectedChartMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=PathXY}"/>
                    </StackPanel>
                </DockPanel>

                <Border Width="640" Height="260" Background="{StaticResource WindowBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <Canvas>
                        <Polyline Points="{Binding ChartPoints, Converter={StaticResource ChartPointsToPolylinePointsConverter}}"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                        <Polyline Points="{Binding ComparePoints, Converter={StaticResource ChartPointsToPolylinePointsConverter}}"
                                  Stroke="{StaticResource DangerBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeDashArray="4,3"
                                  Visibility="{Binding IsComparing, Converter={StaticResource BoolToVisibleConverter}}"/>

                        <ItemsControl ItemsSource="{Binding XTicks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Position}"/>
                                    <Setter Property="Canvas.Top" Value="244"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding YTicks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="2"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Position}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </Border>

                <TextBlock Text="{Binding CompareSummary}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding CompareSummary, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" DockPanel.Dock="Top" Margin="0,0,0,16"
                Visibility="{Binding LastResult, Converter={StaticResource NullToVisibleConverter}}">
            <StackPanel>
                <UniformGrid Columns="3" DataContext="{Binding LastResult}">
                    <StackPanel Margin="0,0,8,10">
                        <TextBlock Text="{Binding SampleCount}" Style="{StaticResource BodyText}" FontWeight="Medium" FontSize="18"/>
                        <TextBlock Text="samples" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                    <StackPanel Margin="8,0,8,10">
                        <TextBlock Text="{Binding DurationMs, StringFormat='{}{0:0.0} ms'}" Style="{StaticResource BodyText}" FontWeight="Medium" FontSize="18"/>
                        <TextBlock Text="duration" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                    <StackPanel Margin="8,0,0,10">
                        <TextBlock Text="{Binding EffectiveReportRateHz, StringFormat='{}{0:0} Hz'}" Style="{StaticResource BodyText}" FontWeight="Medium" FontSize="18"/>
                        <TextBlock Text="effective rate" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,10">
                        <TextBlock Text="{Binding TotalPathCounts, StringFormat='{}{0:0}'}" Style="{StaticResource BodyText}" FontWeight="Medium" FontSize="18"/>
                        <TextBlock Text="path length (counts)" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                    <StackPanel Margin="8,0,8,10">
                        <TextBlock Text="{Binding NetDisplacementCounts, StringFormat='{}{0:0}'}" Style="{StaticResource BodyText}" FontWeight="Medium" FontSize="18"/>
                        <TextBlock Text="net displacement" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                    <StackPanel Margin="8,0,0,10">
                        <TextBlock Text="{Binding PeakSpeedCountsPerMs, StringFormat='{}{0:0.0} cnt/ms'}" Style="{StaticResource BodyText}" FontWeight="Medium" FontSize="18"/>
                        <TextBlock Text="{Binding SpikeSampleIndices.Count, StringFormat='{}peak speed · {0} spike(s) flagged'}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{Binding AngleSnapScore, StringFormat='{}{0:0.00}'}" Style="{StaticResource BodyText}" FontWeight="Medium" FontSize="18"/>
                        <TextBlock Text="angle-snap score (~1 = natural)" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </UniformGrid>

                <DockPanel Margin="0,14,0,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Known distance moved (in):" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox DockPanel.Dock="Left" Width="70" VerticalAlignment="Center"
                             Text="{Binding CalibrationDistanceInches, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button DockPanel.Dock="Left" Content="Measure CPI" Style="{StaticResource AppButton}" Margin="8,0,0,0"
                            Command="{Binding MeasureCpiCommand}"/>
                </DockPanel>
                <TextBlock Text="{Binding MeasuredCpi, StringFormat='Measured CPI: {0:0}'}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"
                           Visibility="{Binding MeasuredCpi, Converter={StaticResource NullToVisibleConverter}}"/>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="{Binding IsSaved, Converter={StaticResource SaveLabelConverter}}"
                            Style="{StaticResource AccentButton}" Command="{Binding SaveResultCommand}"
                            IsEnabled="{Binding IsSaved, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Content="Export CSV" Style="{StaticResource AppButton}" Margin="8,0,0,0" Command="{Binding ExportCsvCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" DockPanel.Dock="Top">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="Saved runs — check two to compare" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Clear compare" Style="{StaticResource AppButton}"
                                Command="{Binding ClearCompareCommand}"
                                Visibility="{Binding IsComparing, Converter={StaticResource BoolToVisibleConverter}}"/>
                        <Button Content="Compare selected" Style="{StaticResource AppButton}" Margin="8,0,0,0"
                                Command="{Binding CompareSelectedCommand}"/>
                    </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding SavedResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MouseSessionRowViewModel}">
                            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}" Padding="0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForCompare}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Session.SavedAt, StringFormat='{}{0:MM/dd HH:mm:ss}'}"
                                               Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Session.DeviceFriendlyName}" Style="{StaticResource BodyText}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Session.DeviceFriendlyName}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Session.PeakSpeedCountsPerMs, StringFormat='{}{0:0.0} cnt/ms peak'}"
                                               Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Session.AngleSnapScore, StringFormat='{}snap {0:0.00}'}"
                                               Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No saved runs yet — capture and save one above."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Visibility="{Binding SavedResults.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
