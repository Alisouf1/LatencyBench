<Window x:Class="LatencyBench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LatencyBench.App"
        xmlns:vm="clr-namespace:LatencyBench.App.ViewModels"
        xmlns:views="clr-namespace:LatencyBench.App.Views"
        xmlns:controls="clr-namespace:LatencyBench.App.Controls"
        mc:Ignorable="d"
        Title="LatencyBench — by Alisouf" Height="760" Width="1080" MinHeight="560" MinWidth="820"
        Icon="Assets/LatencyBench.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizeViewModel}">
            <views:OptimizeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessTuningViewModel}">
            <views:ProcessTuningView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
            <views:MonitorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MsiModeViewModel}">
            <views:MsiModeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AffinityViewModel}">
            <views:AffinityView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TweaksViewModel}">
            <views:TweaksView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PortTestViewModel}">
            <views:PortTestView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DpcIsrViewModel}">
            <views:DpcIsrView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MouseTestViewModel}">
            <views:MouseTestView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel Margin="20,14,20,12" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:Icon Kind="Plug" IconBrush="{StaticResource AccentBrush}" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="LatencyBench" Style="{StaticResource BodyText}" FontWeight="Medium" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="by Alisouf" Style="{StaticResource MutedText}" Margin="8,3,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding RescanStatus}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource AppButton}" Command="{Binding RescanCommand}">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Kind="DpcIsr" IconBrush="{StaticResource TextPrimaryBrush}" Width="13" Height="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Rescan"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                                Command="{Binding RunFullDiagnosticCommand}" IsEnabled="{Binding IsRunningFullDiagnostic, Converter={StaticResource InverseBoolConverter}}"
                                ToolTip="Rescans affinity/MSI, then runs a DPC/ISR trace and a port test together and shows the Action plan. You'll still need to move the mouse or type when it starts the port test.">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Kind="PortTest" IconBrush="White" Width="13" Height="13" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding FullDiagnosticButtonLabel}" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="16,0,16,10">
                    <RadioButton GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dashboard}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="Dashboard" IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="13" Height="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Optimize}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="Advisor" IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="13" Height="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Optimize"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=PortTest}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="PortTest" IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="13" Height="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Port test"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DpcIsr}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="DpcIsr" IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="13" Height="13" Margin="0,0,6,0"/>
                            <TextBlock Text="DPC/ISR"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=MouseTest}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="Mouse" IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="13" Height="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Mouse test"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=MsiMode}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="Msi" IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="13" Height="13" Margin="0,0,6,0"/>
                            <TextBlock Text="MSI mode"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Affinity}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="Affinity" IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="13" Height="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Affinity"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Processes}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="Cpu" IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="13" Height="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Processes"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Monitor}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="DpcIsr" IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="13" Height="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Monitor"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Tweaks}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="Tweaks" IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="13" Height="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Tweaks"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ElevationStatus}" Style="{StaticResource MutedText}"
                   Margin="20,0,20,10" HorizontalAlignment="Right"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </ScrollViewer>
    </DockPanel>
</Window>
