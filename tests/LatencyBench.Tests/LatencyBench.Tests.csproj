<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches LatencyBench.Core. The Core library targets net8.0-windows because it is built
         almost entirely on Win32 interop, the registry and ETW, so the tests must too. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LatencyBench.Core\LatencyBench.Core.csproj" />
  </ItemGroup>

</Project>
